# Where Request Access submissions are delivered.
# PLACEHOLDER — Cliff has not confirmed the destination inbox.
REQUEST_ACCESS_TO_EMAIL=support@motuslabs.co
# Optional. Defaults to noreply@motusaiengine.com, which Resend only accepts
# once that domain is verified. Use onboarding@resend.dev to test before then.
REQUEST_ACCESS_FROM_EMAIL=
RESEND_API_KEY=
NEXT_PUBLIC_SITE_URL=https://motusaiengine.com

# Stripe — add these when ready to test/go live with real checkout.
# Leaving any of these unset makes /checkout fall back to the manual
# request-access flow for that plan, so it's safe to add them one at a time.
STRIPE_SECRET_KEY=
STRIPE_PRICE_AI_STARTER=
STRIPE_PRICE_AI_STARTER_ONBOARDING=
STRIPE_PRICE_AI_PROFESSIONAL=
STRIPE_PRICE_AI_PROFESSIONAL_ONBOARDING=
STRIPE_PRICE_VOICE_STARTER=
STRIPE_PRICE_VOICE_STARTER_ONBOARDING=
STRIPE_PRICE_VOICE_GROWTH=
STRIPE_PRICE_VOICE_GROWTH_ONBOARDING=
STRIPE_PRICE_VOICE_SCALE=
STRIPE_PRICE_VOICE_SCALE_ONBOARDING=
STRIPE_PRICE_VOICE_ENTERPRISE=
STRIPE_PRICE_VOICE_ENTERPRISE_ONBOARDING=
